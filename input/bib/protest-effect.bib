  doi = {10.1086/676853},
  url = {http://www.jstor.org/stable/10.1086/676853},
  urldate = {2025-11-24},
  abstract = {Mobilization for protest is a process of diffusion in interpersonal networks. Extant work has found that being asked by people one knows is a key determinant of participation, but the flip side—asking others—has been neglected. The authors examine which prospective participants are most likely to ask others to participate and whom they ask. Drawing on a new and unusual data set including evidence on more than 7,000 participants in 48 demonstrations across Europe, the authors find that activists who are committed to the demonstration’s cause (willing to recruit others) and who are part of participation-friendly networks (able to recruit others) are the most active recruiters. Asking others is dependent on being asked: participants tend to recruit people similar to those who have recruited them and, most importantly, participants who are recruited via strong ties are less active recruiters themselves.}
}

