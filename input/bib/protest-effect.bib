@article{francisco_relationship_1995,
  title = {The {{Relationship}} between {{Coercion}} and {{Protest}}: {{An Empirical Evaluation}} in {{Three Coercive States}}},
  author = {Francisco, Ronald A.},
  date = {1995},
  journaltitle = {The Journal of Conflict Resolution},
  volume = {39},
  number = {2},
  eprint = {174413},
